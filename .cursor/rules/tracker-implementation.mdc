## 🛠️ Services Layer (Business Logic)

### Tracking Service

```typescript
// src/backend/services/tracking.service.ts
import { db } from "@/lib/db";
import { pageVisits, botDetectors } from "@/backend/db/tables/schema";
import { detectBot, type BotDetectionResult } from "@/features/tracking/utils/bot-detector";
import { parseUserAgent } from "@/features/tracking/utils/user-agent-parser";
import { getGeolocation } from "@/features/tracking/utils/geolocation-service";
import { capturePageVisitSchema, type CapturePageVisitInput } from "@/backend/validators/tracking.validators";
import { unstable_cache } from "next/cache";
import { eq, and, gte, lt, desc } from "drizzle-orm";
import crypto from "crypto";

/**
 * Hash IP address for privacy (one-way hash)
 * Cannot be reversed, only used for grouping in analytics
 * 
 * Security:
 * - Use environment variable SALT for additional entropy
 * - Different salt per deployment prevents rainbow table attacks
 * - SHA256 is collision-resistant for this use case
 */
function hashIp(ip: string): string {
  const salt = process.env.IP_HASH_SALT || "default-salt";
  return crypto
    .createHash("sha256")
    .update(`${ip}${salt}`)
    .digest("hex");
}

/**
 * Capture a single page visit
 * 
 * Steps:
 * 1. Validate input schema
 * 2. Verify project exists and is active
 * 3. Extract IP from headers
 * 4. Detect bot from User-Agent
 * 5. Parse device/browser info
 * 6. Lookup geolocation
 * 7. Store in database
 * 
 * Performance:
 * - IP geolocation is cached for 1 minute per IP
 * - DB insert is direct (no caching) for raw events
 * - Aggregation happens separately (cron jobs)
 */
export async function capturePageVisit(
  data: CapturePageVisitInput,
  ipAddress: string
): Promise<{ id: string; success: boolean; message: string }> {
  try {
    // 1. Validate input
    const validation = capturePageVisitSchema.safeParse(data);
    if (!validation.success) {
      return { 
        id: "", 
        success: false, 
        message: "Invalid tracking data" 
      };
    }

    const payload = validation.data;

    // 2. Verify project exists (prevent logging for deleted projects)
    const projectExists = await db.query.project.findFirst({
      where: (p, { eq }) => eq(p.id, payload.projectId),
      columns: { id: true },
    });

    if (!projectExists) {
      return { 
        id: "", 
        success: false, 
        message: "Project not found" 
      };
    }

    // 3. Detect bot from User-Agent
    const botDetection = detectBot(payload.userAgent);
    
    // 4. Parse User-Agent for device/browser info
    const deviceInfo = parseUserAgent(payload.userAgent);
    
    // 5. Lookup geolocation (cached)
    const geoInfo = await getGeolocation(ipAddress);

    // 6. Extract referrer domain
    let referrerDomain: string | null = null;
    if (payload.referrer) {
      try {
        const url = new URL(payload.referrer);
        referrerDomain = url.hostname;
      } catch {
        // Invalid URL, skip
      }
    }

    // 7. Get current date for daily aggregations
    const today = new Date();
    today.setUTCHours(0, 0, 0, 0);

    // 8. Insert into database
    const result = await db.insert(pageVisits).values({
      projectId: payload.projectId,
      eventType: payload.eventType,
      path: payload.path,
      title: payload.title,
      url: payload.url,
      referrer: payload.referrer,
      referrerDomain,
      utmSource: payload.utmSource,
      utmMedium: payload.utmMedium,
      utmCampaign: payload.utmCampaign,
      utmContent: payload.utmContent,
      utmTerm: payload.utmTerm,
      visitorId: payload.visitorId,
      ipHash: hashIp(ipAddress),
      isBot: botDetection.botType,
      botName: botDetection.botName,
      userAgent: payload.userAgent,
      acceptLanguage: payload.acceptLanguage,
      deviceType: deviceInfo.deviceType || payload.deviceType,
      osName: deviceInfo.osName,
      osVersion: deviceInfo.osVersion,
      browserName: deviceInfo.browserName,
      browserVersion: deviceInfo.browserVersion,
      browserEngine: deviceInfo.browserEngine,
      countryCode: geoInfo.countryCode,
      country: geoInfo.country,
      region: geoInfo.region,
      city: geoInfo.city,
      timezone: geoInfo.timezone,
      latitude: geoInfo.latitude,
      longitude: geoInfo.longitude,
      isProxy: geoInfo.isProxy,
      isMobile: geoInfo.isMobile,
      pageLoadTime: payload.pageLoadTime,
      metadata: payload.metadata || {},
      date: today,
    }).returning({ id: pageVisits.id });

    return {
      id: result[0]?.id || "",
      success: true,
      message: "Visit tracked successfully",
    };
  } catch (error) {
    console.error("[Tracker] Capture error:", error);
    return {
      id: "",
      success: false,
      message: "Failed to track visit",
    };
  }
}

