/**
 * Run all aggregations for a project on a given date
 * Called by cron job daily
 */
export async function aggregateProjectData(projectId: string, date: Date = new Date()) {
  console.log(`[Aggregation] Starting for project ${projectId} on ${date.toISOString()}`);

  try {
    // Run aggregations in sequence (not parallel) to avoid lock contention
    await aggregateAICrawlerLogs(projectId, date);
    await aggregateTrafficSources(projectId, date);
    await aggregateVisitorDemographics(projectId, date);
    await aggregateGeographicActivity(projectId, date);

    console.log(`[Aggregation] Completed for project ${projectId}`);
  } catch (error) {
    console.error(`[Aggregation] Failed for project ${projectId}:`, error);
    throw error;
  }
}
