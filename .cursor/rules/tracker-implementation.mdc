## 🖥️ Frontend Client Integration

### Client-side Tracker Script

```javascript
// public/tracker.js
/**
 * GEO-TRACKER JavaScript
 * 
 * Installation:
 * <script src="https://your-domain.com/tracker.js" data-project-id="YOUR_PROJECT_ID"></script>
 * 
 * Features:
 * - Automatic page view tracking
 * - Device detection (mobile/tablet/desktop)
 * - Referrer capture
 * - UTM parameter extraction
 * - Persistent visitor ID (localStorage)
 * - GDPR compliant (no cookies, no PII)
 * - Fallback support (sendBeacon + fetch)
 * 
 * Performance:
 * - Non-blocking (async)
 * - Minimal payload (~500 bytes)
 * - No external dependencies
 * - Efficient visitor ID persistence
 */

(function() {
  'use strict';

  // Configuration
  const ENDPOINT = '/api/tracking/capture';
  const TRACKING_VERSION = '1.0.0';
  
  // Get project ID from script tag
  const script = document.currentScript;
  if (!script) {
    console.warn('Geo Tracker: Could not access current script element');
    return;
  }

  const projectId = script.getAttribute('data-project-id');
  if (!projectId) {
    console.warn('Geo Tracker: Project ID missing in script tag');
    return;
  }

  /**
   * Generate or retrieve persistent visitor ID
   * Stored in localStorage to track repeat visitors
   * 
   * Privacy Note:
   * - Visitor ID is anonymous (random UUID)
   * - No PII is stored
   * - Users can clear localStorage to reset ID
   * - Cross-domain tracking not possible (scope limited to one domain)
   */
  function getVisitorId() {
    const storageKey = `_geo_tracker_vid_${projectId}`;
    let id = localStorage.getItem(storageKey);
    
    if (!id) {
      // Generate UUID v4
      id = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        const r = Math.random() * 16 | 0;
        const v = c === 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      });
      
      try {
        localStorage.setItem(storageKey, id);
      } catch {
        // localStorage not available (private browsing), use session-only ID
        console.debug('Geo Tracker: localStorage unavailable, using session visitor ID');
      }
    }
    
    return id;
  }

  /**
   * Detect device type from User-Agent
   * 
   * Strategy:
   * - Mobile: Android, iPhone, iPad, Windows Phone
   * - Tablet: iPad, Android (with screen size detection)
   * - Desktop: Other
   */
  function detectDeviceType() {
    const ua = navigator.userAgent.toLowerCase();
    
    if (/iphone|ipod/.test(ua)) return 'mobile';
    if (/ipad/.test(ua)) return 'tablet';
    if (/android/.test(ua)) {
      // Android: check for tablet indicators
      if (/tablet|ipad/.test(ua)) return 'tablet';
      return 'mobile';
    }
    if (/windows phone|blackberry/.test(ua)) return 'mobile';
    
    return 'desktop';
  }

  /**
   * Extract UTM parameters from URL
   */
  function extractUtmParams() {
    const params = {};
    const utmFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    
    try {
      const url = new URL(window.location.href);
      for (const field of utmFields) {
        const value = url.searchParams.get(field);
        if (value) {
          params[field] = value;
        }
      }
    } catch {
      // URL parsing failed
    }
    
    return params;
  }

  /**
   * Track page view
   * Called on initial page load
   * 
   * Data sent:
   * - Page path, title, referrer
   * - Device type, User-Agent
   * - Visitor ID, UTM parameters
   * - Custom metadata
   */
  function trackPageView() {
    try {
      // Collect page data
      const referrer = document.referrer;
      const utmParams = extractUtmParams();
      
      // Build tracking payload
      const payload = {
        projectId,
        eventType: 'page_view',
        path: window.location.pathname,
        url: window.location.href,
        hash: window.location.hash,
        title: document.title,
        referrer: referrer || undefined,
        userAgent: navigator.userAgent,
        visitorId: getVisitorId(),
        deviceType: detectDeviceType(),
        acceptLanguage: navigator.language,
        
        // UTM parameters
        ...(utmParams.utm_source && { utmSource: utmParams.utm_source }),
        ...(utmParams.utm_medium && { utmMedium: utmParams.utm_medium }),
        ...(utmParams.utm_campaign && { utmCampaign: utmParams.utm_campaign }),
        ...(utmParams.utm_content && { utmContent: utmParams.utm_content }),
        ...(utmParams.utm_term && { utmTerm: utmParams.utm_term }),
        
        // Custom metadata
        metadata: {
          trackerVersion: TRACKING_VERSION,
          theme: document.documentElement.getAttribute('data-theme'),
          locale: document.documentElement.getAttribute('lang'),
          characterSet: document.characterSet,
        },
      };

      // Send using sendBeacon (most reliable for page unload)
      const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
      const sent = navigator.sendBeacon(ENDPOINT, blob);

      if (!sent) {
        // Fallback to fetch for browsers without sendBeacon support
        fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true, // Ensure request completes even if page unloads
          signal: AbortSignal.timeout(5000), // 5 second timeout
        }).catch(() => {
          // Silently fail, don't break page
        });
      }
    } catch (error) {
      // Never break page functionality
      console.debug('Geo Tracker: Error tracking page view', error);
    }
  }

  /**
   * Initialize tracker on page load
   */
  function init() {
    // Track page view when DOM is ready
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      trackPageView();
    } else {
      document.addEventListener('DOMContentLoaded', trackPageView);
    }
  }

  // Start tracking
  init();
})();
```

