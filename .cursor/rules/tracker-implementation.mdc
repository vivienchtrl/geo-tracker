## 🧪 Testing & Validation

### Unit Test Examples

```typescript
// src/features/tracking/utils/__tests__/bot-detector.test.ts
import { detectBot, isBot } from '../bot-detector';

describe('Bot Detection', () => {
  it('should detect GPTBot', () => {
    const result = detectBot('Mozilla/5.0 (compatible; GPTBot/1.0)');
    expect(result.botType).toBe('gpt');
    expect(result.confidence).toBe('high');
  });

  it('should detect Claude Web', () => {
    const result = detectBot('Mozilla/5.0 (compatible; Claude-Web/1.0)');
    expect(result.botType).toBe('claude');
  });

  it('should return null for human browsers', () => {
    const result = detectBot('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36');
    expect(result.botType).toBeNull();
  });

  it('should be case-insensitive', () => {
    const result = detectBot('mozilla/5.0 (compatible; gptbot/1.0)');
    expect(result.botType).toBe('gpt');
  });
});
```

