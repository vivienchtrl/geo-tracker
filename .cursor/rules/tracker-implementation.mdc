## 🎯 Validators & Input Contracts

### Tracking Event Validator

```typescript
// src/backend/validators/tracking.validators.ts
import { z } from "zod";

/**
 * Schema for page visit event from client
 * 
 * Design Decisions:
 * - Validate minimal required fields client-side to reduce payload size
 * - Server adds context (IP, geolocation, device parsing)
 * - Metadata is open schema for extensibility
 * - URLs must be valid to prevent injection
 */
export const capturePageVisitSchema = z.object({
  // Required: Project identification
  projectId: z.string()
    .uuid("Invalid project ID format"),
  
  // Required: Event type
  eventType: z.enum(["page_view", "scroll", "interaction", "form_submit"])
    .default("page_view"),
  
  // Required: Page context
  path: z.string()
    .min(1, "Path cannot be empty")
    .max(2048, "Path too long"),
  
  title: z.string()
    .max(512, "Page title too long")
    .optional(),
  
  url: z.string()
    .url("Invalid URL")
    .max(2048, "URL too long")
    .optional(),
  
  // Required: User-Agent (browser identification)
  userAgent: z.string()
    .min(1, "User-Agent required")
    .max(1024, "User-Agent too long"),
  
  // Referrer information
  referrer: z.string()
    .url("Invalid referrer URL")
    .optional()
    .or(z.literal("")),
  
  // UTM Parameters
  utmSource: z.string().max(256).optional(),
  utmMedium: z.string().max(256).optional(),
  utmCampaign: z.string().max(256).optional(),
  utmContent: z.string().max(256).optional(),
  utmTerm: z.string().max(256).optional(),
  
  // Client-side identification
  visitorId: z.string()
    .uuid("Invalid visitor ID format")
    .optional(),
  
  // Device information (from client detection)
  deviceType: z.enum(["mobile", "tablet", "desktop"]).optional(),
  
  // Accept-Language header
  acceptLanguage: z.string().max(256).optional(),
  
  // Custom metadata (strict size limit to prevent abuse)
  metadata: z.record(z.string(), z.any())
    .refine(
      (obj) => JSON.stringify(obj).length < 8192,
      "Metadata too large (max 8KB)"
    )
    .optional(),
  
  // Performance metrics (from client)
  pageLoadTime: z.number().int().positive().optional(),
});

export type CapturePageVisitInput = z.infer<typeof capturePageVisitSchema>;

/**
 * Rate limiting schema for API endpoint
 * Prevents abuse from single IP/project
 */
export const rateLimitingSchema = z.object({
  ip: z.string(),
  projectId: z.string().uuid(),
  timestamp: z.date(),
  eventsInWindow: z.number().int().positive(),
});

/**
 * Geolocation result schema
 * Used internally, not exposed to client
 */
export const geolocationResultSchema = z.object({
  countryCode: z.string().length(2),
  country: z.string(),
  region: z.string().optional(),
  city: z.string().optional(),
  timezone: z.string(),
  latitude: z.string(),
  longitude: z.string(),
  isProxy: z.boolean(),
  isMobile: z.boolean(),
  asn: z.string().optional(),
});

export type GeolocationResult = z.infer<typeof geolocationResultSchema>;
```

