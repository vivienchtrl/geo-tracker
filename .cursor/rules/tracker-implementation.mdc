## 🔗 API Route Implementation

### Tracking Capture Endpoint

```typescript
// src/app/api/tracking/capture/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { capturePageVisit } from '@/backend/services/tracking.service';
import { capturePageVisitSchema } from '@/backend/validators/tracking.validators';
import { db } from '@/lib/db';
import { project } from '@/backend/db/tables/schema';
import { eq } from 'drizzle-orm';

/**
 * POST /api/tracking/capture
 * 
 * Public API endpoint for website tracker
 * 
 * Security Measures:
 * 1. No authentication required (public endpoint)
 * 2. Project ID validation (must exist)
 * 3. Input validation via Zod schemas
 * 4. Rate limiting (via middleware or next/server)
 * 5. Payload size limits (handled by Next.js)
 * 6. IP hashing for privacy
 * 7. No sensitive data stored
 * 
 * Performance Optimization:
 * 1. Non-blocking: Insert and return immediately
 * 2. Aggregation happens separately (cron jobs)
 * 3. Indexes optimized for time-series reads
 * 4. JSONB metadata prevents schema sprawl
 */
export async function POST(request: NextRequest) {
  try {
    // 1. Parse JSON with error handling
    let body;
    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { error: 'Invalid JSON' },
        { status: 400 }
      );
    }

    // 2. Validate input schema
    const validation = capturePageVisitSchema.safeParse(body);
    if (!validation.success) {
      return NextResponse.json(
        { 
          error: 'Validation failed',
          // In production, don't expose internal error details to prevent reconnaissance
          details: process.env.NODE_ENV === 'development' 
            ? validation.error.errors 
            : undefined,
        },
        { status: 400 }
      );
    }

    // 3. Verify project exists and is active
    // This prevents logging for deleted or unauthorized projects
    const existingProject = await db.query.project.findFirst({
      where: eq(project.id, validation.data.projectId),
      columns: { id: true }, // Only fetch ID for optimization
    });

    if (!existingProject) {
      // Return 200 anyway to not leak project existence info
      // But log the attempt (security event)
      console.warn(
        '[Tracker] Invalid project attempt:',
        validation.data.projectId
      );
      return NextResponse.json(
        { message: 'Visit recorded' }, // Misleading response for security
        { status: 200 }
      );
    }

    // 4. Extract client IP
    // Headers are ordered by priority (CDN -> reverse proxy -> direct)
    const ipAddress = 
      request.headers.get('cf-connecting-ip') || // Cloudflare
      request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
      request.headers.get('x-real-ip') ||
      request.headers.get('x-client-ip') ||
      'unknown';

    // 5. Capture the visit
    // This performs bot detection, geolocation, device parsing
    const result = await capturePageVisit(validation.data, ipAddress);

    // 6. Return success response
    return NextResponse.json(
      { 
        success: result.success,
        message: result.message,
        // Optionally return visit ID for debugging in development
        ...(process.env.NODE_ENV === 'development' && { visitId: result.id }),
      },
      { 
        status: result.success ? 200 : 500,
        headers: {
          // Allow cross-origin requests from any domain
          'Access-Control-Allow-Origin': '*',
          'Access-Control-Allow-Methods': 'POST',
          'Access-Control-Allow-Headers': 'Content-Type',
          // Cache policy: don't cache API responses
          'Cache-Control': 'no-cache, no-store, max-age=0',
        },
      }
    );
  } catch (error) {
    console.error('[Tracker] Endpoint error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

/**
 * OPTIONS /api/tracking/capture
 * Handle CORS preflight requests
 */
export async function OPTIONS(request: NextRequest) {
  return new NextResponse(null, {
    status: 200,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type',
      'Access-Control-Max-Age': '86400', // 24 hours
    },
  });
}
