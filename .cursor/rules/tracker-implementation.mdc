## 🔍 Bot Detection Strategy

### Bot Detection Patterns (Client-side + Server-side)

**Key Design Principle**: Layered detection for accuracy and fallback resilience.

```typescript
// src/features/tracking/utils/bot-detector.ts
export type BotType = 
  | 'gpt' 
  | 'claude' 
  | 'google' 
  | 'perplexity' 
  | 'bing' 
  | 'apple'
  | 'amazon'
  | 'bytedance'
  | 'commoncrawl'
  | 'facebook'
  | 'other'
  | null;

export interface BotDetectionResult {
  botType: BotType;
  botName: string | null;
  category: 'ai_crawler' | 'search_engine' | 'social_crawler' | 'monitoring' | null;
  confidence: 'high' | 'medium' | 'low';
  userAgentPattern?: string; // Matched pattern
}

/**
 * Comprehensive bot detection patterns
 * Ordered by specificity (most specific first)
 */
const BOT_PATTERNS = [
  // AI Crawlers (High Priority)
  {
    pattern: /GPTBot|ChatGPT-User/i,
    botType: 'gpt' as BotType,
    botName: 'OpenAI GPT Bot',
    category: 'ai_crawler' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /Claude-Web|Claude-Bot|anthropic/i,
    botType: 'claude' as BotType,
    botName: 'Anthropic Claude',
    category: 'ai_crawler' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /PerplexityBot|pplx-bot/i,
    botType: 'perplexity' as BotType,
    botName: 'Perplexity',
    category: 'ai_crawler' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /AppleWebKit.*Safari.*\(KHTML/i, // Apple's Web Crawler
    botType: 'apple' as BotType,
    botName: 'Apple Web Crawler',
    category: 'ai_crawler' as const,
    confidence: 'medium' as const,
  },
  
  // Search Engines
  {
    pattern: /Googlebot|Google-Extended/i,
    botType: 'google' as BotType,
    botName: 'Googlebot',
    category: 'search_engine' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /BingBot|msnbot|Slurp/i,
    botType: 'bing' as BotType,
    botName: 'BingBot',
    category: 'search_engine' as const,
    confidence: 'high' as const,
  },
  
  // Other Crawlers
  {
    pattern: /AmazonBot|kendra/i,
    botType: 'amazon' as BotType,
    botName: 'Amazon Crawler',
    category: 'monitoring' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /Bytedance|BytespiderBot/i,
    botType: 'bytedance' as BotType,
    botName: 'ByteDance Bot',
    category: 'social_crawler' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /CCBot|CommonCrawl/i,
    botType: 'commoncrawl' as BotType,
    botName: 'Common Crawl',
    category: 'monitoring' as const,
    confidence: 'high' as const,
  },
  {
    pattern: /facebookexternalhit/i,
    botType: 'facebook' as BotType,
    botName: 'Facebook Bot',
    category: 'social_crawler' as const,
    confidence: 'high' as const,
  },
  
  // Generic bot indicators (Low specificity, fallback)
  {
    pattern: /(bot|crawler|spider|wget|curl|scrapy|libcurl|urllib|request|http|java|python)/i,
    botType: 'other' as BotType,
    botName: 'Unknown Bot',
    category: 'monitoring' as const,
    confidence: 'low' as const,
  },
];

/**
 * Detect bot from User-Agent string
 * Returns comprehensive detection result
 */
export function detectBot(userAgent: string): BotDetectionResult {
  if (!userAgent) {
    return { botType: null, botName: null, category: null, confidence: 'low' };
  }

  // Iterate through patterns in order (most specific first)
  for (const detector of BOT_PATTERNS) {
    if (detector.pattern.test(userAgent)) {
      return {
        botType: detector.botType,
        botName: detector.botName,
        category: detector.category,
        confidence: detector.confidence,
        userAgentPattern: detector.pattern.source,
      };
    }
  }

  return { botType: null, botName: null, category: null, confidence: 'low' };
}

/**
 * Check if User-Agent is a bot
 * @returns true if bot detected (any type)
 */
export function isBot(userAgent: string): boolean {
  return detectBot(userAgent).botType !== null;
}

/**
 * Check if specific bot type
 */
export function isBotType(userAgent: string, type: BotType): boolean {
  return detectBot(userAgent).botType === type;
}
```

