## 🔄 Daily Aggregation (Cron Jobs)

### Aggregation Service

```typescript
// src/backend/services/tracking-aggregation.service.ts
import { db } from "@/lib/db";
import { 
  pageVisits, 
  aiCrawlerLogs, 
  trafficSources,
  visitorDemographics,
  geographicActivity,
} from "@/backend/db/tables/schema";
import { and, eq, gte, lt, desc, sql } from "drizzle-orm";
import { revalidateTag } from "next/cache";

/**
 * Aggregate AI crawler activity for a given date
 * 
 * Purpose:
 * - Reduce storage and query time by pre-aggregating raw events
 * - Enable fast dashboard queries
 * - Track bot behavior trends
 * 
 * Called by: Cron job (daily at 1 AM UTC)
 */
export async function aggregateAICrawlerLogs(projectId: string, date: Date) {
  const dateStart = new Date(date);
  dateStart.setUTCHours(0, 0, 0, 0);
  const dateEnd = new Date(dateStart.getTime() + 86400000); // +1 day

  try {
    // 1. Query raw visits for this project+date filtered by bots
    const botActivityByType = await db
      .select({
        botId: pageVisits.isBot,
        botName: pageVisits.botName,
        requestsCount: sql<number>`COUNT(*)`,
        uniqueVisits: sql<number>`COUNT(DISTINCT ${pageVisits.visitorId})`,
        pagesAccessed: sql<number>`COUNT(DISTINCT ${pageVisits.path})`,
        avgTimeOnPage: sql<number>`AVG(EXTRACT(EPOCH FROM (${pageVisits.createdAt} - lag(${pageVisits.createdAt}) OVER (PARTITION BY ${pageVisits.isBot} ORDER BY ${pageVisits.createdAt}))))`,
        topPages: sql<string>`json_agg(distinct ${pageVisits.path} order by count desc) FILTER (WHERE count <= 5)`,
      })
      .from(pageVisits)
      .where(
        and(
          eq(pageVisits.projectId, projectId),
          gte(pageVisits.createdAt, dateStart),
          lt(pageVisits.createdAt, dateEnd),
          pageVisits.isBot !== null // Only bots
        )
      )
      .groupBy(pageVisits.isBot, pageVisits.botName);

    // 2. Upsert into aiCrawlerLogs
    for (const row of botActivityByType) {
      if (row.botId) {
        await db
          .insert(aiCrawlerLogs)
          .values({
            projectId,
            date: dateStart,
            botId: row.botId,
            botName: row.botName || row.botId,
            botCategory: 'ai_crawler', // Refine based on bot type
            requestsCount: row.requestsCount || 0,
            uniqueVisits: row.uniqueVisits || 0,
            pagesAccessed: row.pagesAccessed || 0,
            avgTimeOnPage: row.avgTimeOnPage || 0,
          })
          .onConflictDoUpdate({
            target: [aiCrawlerLogs.projectId, aiCrawlerLogs.date, aiCrawlerLogs.botId],
            set: {
              requestsCount: row.requestsCount || 0,
              uniqueVisits: row.uniqueVisits || 0,
              pagesAccessed: row.pagesAccessed || 0,
              avgTimeOnPage: row.avgTimeOnPage || 0,
            },
          });
      }
    }

    revalidateTag('ai-crawler-logs');
  } catch (error) {
    console.error('[Aggregation] AI crawler logs error:', error);
    throw error;
  }
}

/**
 * Aggregate traffic sources for a given date
 */
export async function aggregateTrafficSources(projectId: string, date: Date) {
  const dateStart = new Date(date);
  dateStart.setUTCHours(0, 0, 0, 0);
  const dateEnd = new Date(dateStart.getTime() + 86400000);

  try {
    const trafficBySource = await db
      .select({
        source: pageVisits.referrerDomain || sql<string>`'direct'`,
        medium: pageVisits.utmMedium || sql<string>`'organic'`,
        visits: sql<number>`COUNT(*)`,
        visitors: sql<number>`COUNT(DISTINCT ${pageVisits.visitorId})`,
      })
      .from(pageVisits)
      .where(
        and(
          eq(pageVisits.projectId, projectId),
          eq(pageVisits.isBot, null), // Only humans
          gte(pageVisits.createdAt, dateStart),
          lt(pageVisits.createdAt, dateEnd)
        )
      )
      .groupBy(
        pageVisits.referrerDomain,
        pageVisits.utmMedium
      );

    for (const row of trafficBySource) {
      await db
        .insert(trafficSources)
        .values({
          projectId,
          date: dateStart,
          source: row.source || 'direct',
          medium: row.medium,
          visits: row.visits || 0,
          visitors: row.visitors || 0,
        })
        .onConflictDoUpdate({
          target: [trafficSources.projectId, trafficSources.date, trafficSources.source, trafficSources.medium],
          set: {
            visits: row.visits || 0,
            visitors: row.visitors || 0,
          },
        });
    }

    revalidateTag('traffic-sources');
  } catch (error) {
    console.error('[Aggregation] Traffic sources error:', error);
    throw error;
  }
}

/**
